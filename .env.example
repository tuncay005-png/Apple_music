# Yandex Music konfiqurasiyası
YANDEX_TOKEN=your_yandex_music_token_here
YANDEX_PLAYLIST_ID=your_yandex_playlist_id_here

# YouTube konfiqurasiyası
YOUTUBE_PLAYLIST_ID=your_youtube_playlist_id_here

# Google Drive konfiqurasiyası (Google Drive-a yükləmək üçün)
# Google Drive API üçün service account JSON məzmunu və ya OAuth token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Rclone konfiqurasiyası (alternativ yükləmə üsulu)
RCLONE_CONFIG_CONTENT=your_rclone_config_base64_encoded_here
RCLONE_REMOTE_NAME=googledrive
RCLONE_REMOTE_PATH=/Apple_Music

# Yoxlama intervalı (dəqiqə ilə, GitHub Actions üçün vacib deyil)
CHECK_INTERVAL_MINUTES=1440
